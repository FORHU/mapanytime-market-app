# Android Release Signing Configuration Example
# Copy this file to android/key.properties and configure your keystore values.
# NEVER commit key.properties or keystore files (.keystore, .jks) to version control.
#
# To create an upload keystore:
# keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
keyAlias=upload
keyPassword=your-key-password
storeFile=../upload-keystore.jks
storePassword=your-store-password
